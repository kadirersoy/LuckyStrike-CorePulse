<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="CorePulse" Manufacturer="LuckyStrike" Version="$(var.Version)" UpgradeCode="78A5F231-9F02-4A63-8E5A-7C38B124F65D">
    <MajorUpgrade DowngradeErrorMessage="Daha yeni bir CorePulse sÃ¼rÃ¼mÃ¼ zaten yÃ¼klÃ¼." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CorePulse" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ApplicationShortcut" Guid="B4D7203E-C189-4FA2-B583-6C78F23A1054">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="CorePulse"
                  Description="CorePulse - Windows DonanÄ±m Ä°zleme Merkezi"
                  Target="[INSTALLFOLDER]CorePulse.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\LuckyStrike\CorePulse" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="CorePulseComponents" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <ComponentGroup Id="CorePulseComponents" Directory="INSTALLFOLDER">
      <Files Include="publish\**" />
    </ComponentGroup>
  </Package>
</Wix>
