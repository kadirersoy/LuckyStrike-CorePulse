<Window x:Class="CorePulse.App.DiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:CorePulse.Core.Models;assembly=CorePulse.Core"
        mc:Ignorable="d"
        Title="Donanım ve Sensör Keşif Sihirbazı - CorePulse" 
        Height="720" Width="960"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource TextPrimary}"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="{StaticResource CardBorder}"
        BorderThickness="1">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" CornerRadius="16" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource ModalBackground}" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Action Tools -->
                <RowDefinition Height="*"/>    <!-- Sensors Scroll List -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="#161C2E" CornerRadius="16,16,0,0" Padding="20,12" 
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <!-- Close button -->
                    <Button DockPanel.Dock="Right" Content="✕" Width="32" Height="32" FontSize="14"
                            Style="{StaticResource ModernOutlineButton}" Click="CloseButton_Click"
                            Padding="0" WindowChrome.IsHitTestVisibleInChrome="True"/>

                    <!-- App Icon & Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#0891B2" Margin="0,0,12,0">
                            <TextBlock Text="⚡" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Donanım ve Sensör Keşif Sihirbazı (Analyze Sensors)" FontSize="15" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Sistemdeki tüm aktif sensörler taranmıştır. Görmek istediklerinizi seçip kişiselleştirin." 
                                       FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Action Tools Bar -->
            <Border Grid.Row="1" Background="#0D121F" Padding="20,10" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Yeniden Tara (Mevcut Düzeni Koru)" Command="{Binding RescanCommand}" 
                                Style="{StaticResource ModernOutlineButton}" Margin="0,0,10,0"/>
                        <Button Content="Varsayılanları Seç" Command="{Binding SelectRecommendedCommand}" 
                                Style="{StaticResource ModernOutlineButton}" Margin="0,0,10,0"/>
                        <Button Content="Tümünü Seç" Command="{Binding SelectAllCommand}" 
                                Style="{StaticResource ModernOutlineButton}"/>
                    </StackPanel>

                    <!-- Counts -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Bulunan Sensör Sayısı: " FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding TotalFound}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CyanNeon}" FontFamily="Consolas"/>
                        <TextBlock Text="  |  Seçili: " FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding SelectedCount}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource EmeraldNeon}" FontFamily="Consolas"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Scrollable Discovered Sensors List -->
            <ScrollViewer Grid.Row="2" Padding="20,14" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CategoryGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Category Box -->
                            <Border Background="#141A29" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" 
                                    CornerRadius="14" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <!-- Category Header -->
                                    <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="{Binding CategoryName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    </DockPanel>

                                    <!-- Sensors in Category -->
                                    <ItemsControl ItemsSource="{Binding Sensors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" 
                                                        CornerRadius="10" Padding="10,8" Margin="0,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>  <!-- Checkbox -->
                                                            <ColumnDefinition Width="220"/> <!-- Sensor Renaming & Original Name -->
                                                            <ColumnDefinition Width="90"/>  <!-- Live Value -->
                                                            <ColumnDefinition Width="140"/> <!-- Widget Type -->
                                                            <ColumnDefinition Width="150"/> <!-- Thresholds -->
                                                            <ColumnDefinition Width="*"/>   <!-- Audio Alert -->
                                                        </Grid.ColumnDefinitions>

                                                        <!-- CheckBox -->
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                                  Style="{StaticResource ModernCheckBox}" HorizontalAlignment="Center"/>

                                                        <!-- Name inputs -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBox Text="{Binding CustomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                     Style="{StaticResource ModernTextBox}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding OriginalName, StringFormat='Orijinal: {0}'}" 
                                                                       FontSize="10" Foreground="{StaticResource TextMuted}" Margin="2,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- Live Value -->
                                                        <TextBlock Grid.Column="2" Text="{Binding FormattedFull}" FontSize="12" 
                                                                   FontWeight="Bold" Foreground="{StaticResource CyanNeon}" 
                                                                   VerticalAlignment="Center" FontFamily="Consolas"/>

                                                        <!-- Widget Type Selector -->
                                                        <ComboBox Grid.Column="3" SelectedItem="{Binding WidgetType, Mode=TwoWay}" 
                                                                  VerticalAlignment="Center" Margin="0,0,10,0" Height="28">
                                                            <models:WidgetType>CircularGauge</models:WidgetType>
                                                            <models:WidgetType>GlowBar</models:WidgetType>
                                                            <models:WidgetType>Sparkline</models:WidgetType>
                                                            <models:WidgetType>KeyValue</models:WidgetType>
                                                            <models:WidgetType>CapacityBar</models:WidgetType>
                                                        </ComboBox>

                                                        <!-- Threshold Inputs -->
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Eşik: " FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                                            <TextBox Text="{Binding CriticalThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                     Width="45" Height="26" Style="{StaticResource ModernTextBox}" FontFamily="Consolas"/>
                                                            <TextBlock Text="{Binding Unit}" FontSize="10" Foreground="{StaticResource TextMuted}" 
                                                                       VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                        </StackPanel>

                                                        <!-- Audio Alert Checkbox -->
                                                        <CheckBox Grid.Column="5" IsChecked="{Binding IsAudioAlertEnabled, Mode=TwoWay}" 
                                                                  Style="{StaticResource ModernCheckBox}" HorizontalAlignment="Right"
                                                                  ToolTip="Kritik eşik aşıldığında sesli alarm çal">
                                                            <TextBlock Text="🔔 Sesli Alarm" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                        </CheckBox>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="3" Background="#161C2E" Padding="20,14" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="İptal" Click="CloseButton_Click" Style="{StaticResource ModernOutlineButton}" Margin="0,0,10,0"/>
                        <Button Content="Değişiklikleri Kaydet &amp; Panoya Uygula" Command="{Binding SaveAndApplyCommand}" 
                                Style="{StaticResource ModernPrimaryButton}"/>
                    </StackPanel>
                    <TextBlock Text="Yapılandırmanız otomatik kaydedilir ve sonraki açılışlarda hatırlanır." 
                               FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
