<UserControl x:Class="CorePulse.App.Controls.CircularRingGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="240">
    <Border x:Name="RootBorder" Background="{StaticResource CardBackground}" 
            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
            CornerRadius="16" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Title -->
            <DockPanel Grid.Row="0" LastChildFill="True">
                <Border DockPanel.Dock="Right" Background="#0E3048" CornerRadius="6" Padding="6,2">
                    <TextBlock Text="Dairesel" FontSize="10" Foreground="{StaticResource CyanNeon}" FontFamily="Consolas"/>
                </Border>
                <TextBlock x:Name="TxtTitle" Text="CPU Frekansı" FontSize="12" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Circular Dial Area -->
            <Grid Grid.Row="1" Width="170" Height="170" Margin="0,10">
                <!-- Background Circle Track -->
                <Path Stroke="#1E293B" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="85,15">
                                <ArcSegment Point="84.99,15" Size="70,70" IsLargeArc="True" SweepDirection="Clockwise"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>

                <!-- Active Progress Arc -->
                <Path x:Name="ArcProgress" Stroke="{StaticResource CpuRadialGradient}" 
                      StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure x:Name="ArcFigure" StartPoint="85,15">
                                <ArcSegment x:Name="ArcSegmentProgress" Point="85,15" Size="70,70" SweepDirection="Clockwise"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>

                <!-- Center Value & Unit -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtValue" Text="5225" FontSize="30" FontWeight="Black" 
                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"
                               FontFamily="Consolas"/>
                    <TextBlock x:Name="TxtUnit" Text="MHz" FontSize="12" FontWeight="Bold" 
                               Foreground="{StaticResource CyanNeon}" HorizontalAlignment="Center"
                               FontFamily="Consolas" Margin="0,-2,0,2"/>
                    <TextBlock x:Name="TxtSub" Text="Maks: 5600 MHz" FontSize="10" 
                               Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Footer Min / Avg Stats -->
            <Border Grid.Row="2" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtMin" Grid.Column="0" Text="Min: 3200" FontSize="11" 
                               Foreground="{StaticResource TextMuted}" FontFamily="Consolas"/>
                    <TextBlock x:Name="TxtMax" Grid.Column="1" Text="Ort: 4850" FontSize="11" 
                               Foreground="{StaticResource CyanNeon}" HorizontalAlignment="Right" FontFamily="Consolas"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
