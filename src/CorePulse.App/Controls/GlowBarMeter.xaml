<UserControl x:Class="CorePulse.App.Controls.GlowBarMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="240">
    <Border x:Name="RootBorder" Background="{StaticResource CardBackground}" 
            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
            CornerRadius="16" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Title & Status Badge -->
            <DockPanel Grid.Row="0" LastChildFill="True">
                <Border x:Name="BadgeBorder" DockPanel.Dock="Right" Background="#052E16" CornerRadius="6" Padding="6,2">
                    <TextBlock x:Name="TxtStatus" Text="NORMAL" FontSize="10" Foreground="{StaticResource EmeraldNeon}" 
                               FontWeight="Bold" FontFamily="Consolas"/>
                </Border>
                <TextBlock x:Name="TxtTitle" Text="CPU Sıcaklığı" FontSize="12" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Big Number Readout -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,15">
                <TextBlock x:Name="TxtValue" Text="52" FontSize="46" FontWeight="Black" 
                           Foreground="{StaticResource TextPrimary}" FontFamily="Consolas"/>
                <TextBlock x:Name="TxtUnit" Text="°C" FontSize="20" FontWeight="Bold" 
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,8"/>
            </StackPanel>

            <!-- Glow Bar Underneath -->
            <StackPanel Grid.Row="2" Margin="0,5,0,0">
                <Border Height="8" Background="#1E293B" CornerRadius="4">
                    <Grid>
                        <ProgressBar x:Name="BarValue" Value="52" Maximum="100" Height="8" 
                                     Foreground="{StaticResource CyanNeon}" Background="Transparent" BorderThickness="0"/>
                    </Grid>
                </Border>
                <Grid Margin="0,6,0,0">
                    <TextBlock x:Name="TxtMinScale" Text="0" FontSize="10" Foreground="{StaticResource TextMuted}" FontFamily="Consolas"/>
                    <TextBlock x:Name="TxtThreshold" Text="Eşik: 85°C" FontSize="10" Foreground="{StaticResource AmberNeon}" 
                               HorizontalAlignment="Center" FontFamily="Consolas"/>
                    <TextBlock x:Name="TxtMaxScale" Text="100" FontSize="10" Foreground="{StaticResource TextMuted}" 
                               HorizontalAlignment="Right" FontFamily="Consolas"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
