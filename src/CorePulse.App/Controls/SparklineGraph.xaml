<UserControl x:Class="CorePulse.App.Controls.SparklineGraph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="140" d:DesignWidth="400">
    <Border Background="{StaticResource CardBackground}" 
            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
            CornerRadius="16" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Graph Header -->
            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border Background="#06B6D4" Width="8" Height="8" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtLegendPrimary" Text="CPU Sıcaklık" FontSize="11" Foreground="{StaticResource CyanNeon}" 
                               FontFamily="Consolas" Margin="0,0,12,0"/>
                    <Border Background="#F43F5E" Width="8" Height="8" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtLegendSecondary" Text="GPU Yükü" FontSize="11" Foreground="{StaticResource RoseNeon}" 
                               FontFamily="Consolas"/>
                </StackPanel>
                <TextBlock Text="CANLI SICAKLIK &amp; YÜK GEÇMİŞİ (60 SN)" FontSize="12" FontWeight="Bold" 
                           Foreground="{StaticResource TextSecondary}"/>
            </DockPanel>

            <!-- Wave Canvas -->
            <Canvas x:Name="WaveCanvas" Grid.Row="1" ClipToBounds="True" Height="70" Background="#0F172A">
                <!-- Grid Lines -->
                <Line X1="0" Y1="17" X2="1000" Y2="17" Stroke="#1E293B" StrokeDashArray="3 3"/>
                <Line X1="0" Y1="35" X2="1000" Y2="35" Stroke="#1E293B" StrokeDashArray="3 3"/>
                <Line X1="0" Y1="53" X2="1000" Y2="53" Stroke="#1E293B" StrokeDashArray="3 3"/>

                <!-- Primary Area Wave -->
                <Polygon x:Name="PolyAreaPrimary" Fill="#1506B6D4"/>
                <Polyline x:Name="PolyPrimary" Stroke="{StaticResource CyanNeon}" StrokeThickness="2.5" 
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>

                <!-- Secondary Wave -->
                <Polyline x:Name="PolySecondary" Stroke="{StaticResource RoseNeon}" StrokeThickness="2" 
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Canvas>
        </Grid>
    </Border>
</UserControl>
