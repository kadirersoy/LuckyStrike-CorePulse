<UserControl x:Class="CorePulse.App.Controls.MetricRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignWidth="360">
    <Border x:Name="RootBorder" Background="Transparent" CornerRadius="8" Padding="10,6" Margin="0,1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Main Row (Key-Value) -->
            <DockPanel Grid.Row="0" LastChildFill="True">
                <!-- Value with unit and optional alert dot -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="AlertDot" Width="6" Height="6" Fill="{StaticResource RoseNeon}" 
                             Margin="0,0,6,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtValue" Text="1572 RPM" FontSize="12" FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimary}" FontFamily="Consolas"/>
                </StackPanel>

                <!-- Sensor Name -->
                <TextBlock x:Name="TxtName" Text="CPU Fan 1" FontSize="12" 
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Optional Sub Progress Bar (For Capacity / Disk / RAM) -->
            <Grid x:Name="BarContainer" Grid.Row="1" Margin="0,5,0,2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <Border Height="6" Background="#1E293B" CornerRadius="3" VerticalAlignment="Center">
                    <ProgressBar x:Name="ProgressBar" Height="6" Value="74" Maximum="100" 
                                 Foreground="{StaticResource CyanNeon}" Background="Transparent" BorderThickness="0"/>
                </Border>
                <TextBlock x:Name="TxtPercent" Grid.Column="1" Text="74%" FontSize="10" FontWeight="Bold" 
                           Foreground="{StaticResource CyanNeon}" HorizontalAlignment="Right" FontFamily="Consolas"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
